# Root .gitignore — cross-cutting only. Stack-specific ignores live in each
# subdir's .gitignore (react-native/.gitignore, flutter/.gitignore).

# OS
.DS_Store
Thumbs.db

# Editor / IDE
.idea/
.vscode/

# Claude Code per-machine config (applies to any nested .claude/ directory)
**/.claude/settings.local.json

# Secrets (never committed at any level)
**/.env
**/.env.local
**/.env.*.local

# Coverage / logs (anywhere in the tree)
**/coverage/
**/*.log
