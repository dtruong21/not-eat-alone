# Claude Code per-machine config
.claude/settings.local.json

# Dart / Flutter
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/
doc/api/

# IDEs
.idea/
.vscode/
*.iml
*.iws
*.ipr

# OS
.DS_Store
*.log

# Env (loaded at runtime via flutter_dotenv — never commit real values)
.env
.env.*
!.env.example

# iOS
ios/Pods/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/.symlinks/
ios/Runner.xcworkspace/xcuserdata/
ios/Runner.xcodeproj/xcuserdata/
ios/Runner.xcodeproj/project.xcworkspace/xcuserdata/

# Android
android/.gradle/
android/local.properties
android/key.properties
android/app/key.jks
android/app/keystore.jks
android/captures/
android/gradlew
android/gradlew.bat
android/gradle/

# Web
/web/

# Native secrets (never commit — see docs/SECURITY.md)
google-services.json
GoogleService-Info.plist
*.jks
*.keystore
*service-account*.json

# Generated code — gitignored by default for cleaner diffs.
# Regenerated by `dart run build_runner build` on every checkout.
# If your team prefers committing generated files for faster cold-clones,
# remove these three lines (and adjust the analysis_options.yaml exclude list).
**/*.g.dart
**/*.freezed.dart
**/generated_plugin_registrant.dart

# Exception: firebase_options.dart is generated but MUST be committed.
# It contains the web API key, which is NOT secret (see master spec §5 gotcha #2).
!lib/firebase_options.dart

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Codemagic local artifacts
codemagic-build-output/
