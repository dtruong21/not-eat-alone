# Claude Code per-machine config
.claude/settings.local.json

# Dart / Flutter
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/
doc/api/

# IDEs
.idea/
.vscode/
*.iml
*.iws
*.ipr

# OS
.DS_Store
*.log

# Env (loaded at runtime via flutter_dotenv — never commit real values)
.env
.env.*
!.env.example

# iOS
ios/Pods/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/.symlinks/
ios/Runner.xcworkspace/xcuserdata/
ios/Runner.xcodeproj/xcuserdata/
ios/Runner.xcodeproj/project.xcworkspace/xcuserdata/
ios/**/xcshareddata/swiftpm/

# Android
android/.gradle/
android/local.properties
android/key.properties
android/app/key.jks
android/app/keystore.jks
android/captures/
android/gradlew
android/gradlew.bat
android/gradle/

# Web
/web/

# Native secrets (never commit — see docs/SECURITY.md)
*.jks
*.keystore
*service-account*.json

# flutterfire configure's scratch output at the default (unflavored) native
# paths — transient, overwritten by whichever `flutterfire configure` run
# last touched it. NOT the committed artifacts (see below): those live at
# android/app/src/{prod,stage}/google-services.json and
# ios/config/{prod,stage}/GoogleService-Info.plist.
/android/app/google-services.json
/ios/Runner/GoogleService-Info.plist

# Exception: per-flavor google-services.json / GoogleService-Info.plist MUST
# be committed. Per docs/SECURITY.md, these are not secret — Firebase/Google
# OAuth client config ships in every app bundle by design; security comes
# from Firestore Rules + Firebase Auth, not from hiding this file.
!android/app/src/prod/google-services.json
!android/app/src/stage/google-services.json
!ios/config/prod/GoogleService-Info.plist
!ios/config/stage/GoogleService-Info.plist

# Generated code — gitignored by default for cleaner diffs.
# Regenerated by `dart run build_runner build` on every checkout.
# If your team prefers committing generated files for faster cold-clones,
# remove these three lines (and adjust the analysis_options.yaml exclude list).
**/*.g.dart
**/*.freezed.dart
**/generated_plugin_registrant.dart

# Exception: firebase_options.dart is generated but MUST be committed.
# It contains the web API key, which is NOT secret (see master spec §5 gotcha #2).
!lib/firebase_options.dart

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Codemagic local artifacts
codemagic-build-output/

# FVM Version Cache
.fvm/