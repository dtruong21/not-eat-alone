# Firebase web config — fill from console.firebase.google.com → Project settings → Your apps
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google OAuth — Firebase Console → Authentication → Sign-in method → Google → Web client ID
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=
# After cutting a native dev build, add platform-specific client IDs from Google Cloud Console
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS_NATIVE=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=

# Legal pages — host the markdown from docs/legal/ somewhere public and put the URLs here.
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=

# Analytics — pick ONE provider, wire in lib/analytics/client.ts
# Default recommendation: PostHog (free tier ~1M events/month covers MVP)
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Crash reporting — Sentry (separate from product analytics)
EXPO_PUBLIC_SENTRY_DSN=

# Set to "1" to fire analytics in dev (default: dev events log to console only)
EXPO_PUBLIC_ANALYTICS_IN_DEV=
