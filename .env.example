# Loaded at runtime via flutter_dotenv. The file is bundled in the app —
# values here are NOT secret (see docs/SECURITY.md). Security comes from
# Firestore rules + Firebase App Check, not from hiding API keys.
#
# Copy to `.env` and fill in. The .env file is gitignored.

# Firebase web config — Firebase Console → Project settings → Your apps.
# Note: For Flutter, the canonical source is lib/firebase_options.dart (generated
# by `flutterfire configure`). These mirror those values for non-FlutterFire
# integrations (e.g. raw REST calls, custom analytics bridges).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Google OAuth — Firebase Console → Authentication → Sign-in method → Google.
# After cutting native builds, add platform-specific client IDs from Google Cloud Console.
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_IOS_NATIVE=
GOOGLE_CLIENT_ID_ANDROID=

# Legal pages — host the markdown from docs/legal/ somewhere public and put the URLs here.
PRIVACY_URL=
TERMS_URL=

# Product analytics — PostHog (free tier ~1M events/month covers MVP).
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Crash + performance — Sentry (separate from product analytics).
SENTRY_DSN=

# Set to "1" to fire analytics in dev (default: dev events log to console only).
ANALYTICS_IN_DEV=
