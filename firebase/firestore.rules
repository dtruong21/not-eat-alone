rules_version = '2';

// Starter rules: deny-by-default. Replace the matchers below as you add collections.
// Test every rule in the Firebase Console → Firestore → Rules → Playground before deploying.
//
// Canonical pattern: scope everything under users/{uid} and check request.auth.uid == uid.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function matchParticipant(matchId) {
      let m = get(/databases/$(database)/documents/matches/$(matchId)).data;
      return isSignedIn()
             && (request.auth.uid == m.hostId || request.auth.uid == m.guestId);
    }

    function noBlockBetween(a, b) {
      return !exists(/databases/$(database)/documents/blocks/$(a + '_' + b))
             && !exists(/databases/$(database)/documents/blocks/$(b + '_' + a));
    }

    // The `matches` create rule's approve-transaction check. `get()` is the
    // state BEFORE the write/transaction, `getAfter()` the state AFTER it, so
    // this proves the request was pending and is being set to `approved`, and
    // the meal was open and is being set to `matched` with this guest, all in
    // the same transaction (RequestRepositoryImpl.approve). Request id is
    // `{mealId}_{guestId}`. 4 distinct doc reads (+2 `exists` in noBlockBetween)
    // stay well inside the 20-access transaction limit.
    function matchApprovalValid(mealId, guestId, hostId) {
      let reqPath  = /databases/$(database)/documents/requests/$(mealId + '_' + guestId);
      let mealPath = /databases/$(database)/documents/meals/$(mealId);
      let reqBefore  = get(reqPath).data;
      let reqAfter   = getAfter(reqPath).data;
      let mealBefore = get(mealPath).data;
      let mealAfter  = getAfter(mealPath).data;
      return reqBefore.status == 'pending'
          && reqBefore.hostId == hostId
          && reqBefore.guestId == guestId
          && reqAfter.status == 'approved'
          && mealBefore.status == 'open'
          && mealBefore.hostId == hostId
          && mealAfter.status == 'matched'
          && mealAfter.guestId == guestId;
    }

    function ratingParticipantsValid(matchId, rater, target) {
      let m = get(/databases/$(database)/documents/matches/$(matchId)).data;
      return (rater == m.hostId && target == m.guestId)
          || (rater == m.guestId && target == m.hostId);
    }

    // Reads the parent match ONCE (via `let`) to check both that `uid` is a
    // participant and that no block exists between the two parties — avoids the
    // repeated get() of the same match doc a per-condition inline check needs.
    function matchMessageCreateOk(matchId, uid) {
      let m = get(/databases/$(database)/documents/matches/$(matchId)).data;
      return (uid == m.hostId || uid == m.guestId)
             && noBlockBetween(uid, uid == m.hostId ? m.guestId : m.hostId);
    }

    // Per-user docs
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid)
                    && request.resource.data.uid == uid
                    && request.resource.data.dob is timestamp
                    && request.resource.data.ageVerified is bool
                    && request.resource.data.get('ratingSum', 0) == 0
                    && request.resource.data.get('ratingCount', 0) == 0
                    && request.resource.data.get('ratingAvg', 0) == 0;
      allow update: if isOwner(uid)
                    && request.resource.data.get('ratingSum', 0) == resource.data.get('ratingSum', 0)
                    && request.resource.data.get('ratingCount', 0) == resource.data.get('ratingCount', 0)
                    && request.resource.data.get('ratingAvg', 0) == resource.data.get('ratingAvg', 0);
      allow delete: if false; // account deletion via Cloud Function later

      // Add subcollections here as you build features.
      // Each subcollection should have its own explicit allow/deny block.
      //
      // Example:
      // match /things/{thingId} {
      //   allow read, write: if isOwner(uid);
      // }

      match /fcmTokens/{token} {
        allow read, write: if isOwner(uid);
      }
    }

    // Meal listings created by a host
    match /meals/{mealId} {
      allow create: if isSignedIn()
                    && request.resource.data.hostId == request.auth.uid
                    && request.resource.data.status is string
                    && request.resource.data.geohash is string
                    && request.resource.data.dateTime is timestamp;
      allow read: if isSignedIn();
      allow update, delete: if isSignedIn() && resource.data.hostId == request.auth.uid;
    }

    // Join requests: guest creates for an OPEN meal; host reviews.
    match /requests/{requestId} {
      // get: a party to an existing request, OR the guest reading their OWN
      // not-yet-created request (id is `{mealId}_{guestId}` — see
      // RequestRepositoryImpl._requestId) so the meal-detail listener resolves
      // to "no request yet". Scoping the null case to the caller's own id
      // avoids an existence oracle on other users' requests.
      allow get: if isSignedIn()
                 && ((resource == null
                      && requestId.matches('.*_' + request.auth.uid))
                     || (resource != null
                         && (resource.data.guestId == request.auth.uid
                             || resource.data.hostId == request.auth.uid)));
      allow list: if isSignedIn()
                  && (resource.data.guestId == request.auth.uid
                      || resource.data.hostId == request.auth.uid);
      // Doc id pinned to `{mealId}_{callerUid}` (the id the app writes) so a
      // caller can't squat another user's request id and lock them out.
      allow create: if isSignedIn()
                    && requestId == request.resource.data.mealId + '_' + request.auth.uid
                    && request.resource.data.guestId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.hostId != request.auth.uid
                    && exists(/databases/$(database)/documents/meals/$(request.resource.data.mealId))
                    && get(/databases/$(database)/documents/meals/$(request.resource.data.mealId)).data.status == 'open'
                    && get(/databases/$(database)/documents/meals/$(request.resource.data.mealId)).data.hostId == request.resource.data.hostId
                    && noBlockBetween(request.resource.data.guestId, request.resource.data.hostId)
                    && (get(/databases/$(database)/documents/meals/$(request.resource.data.mealId)).data.womenOnly == false
                        || get(/databases/$(database)/documents/users/$(request.resource.data.guestId)).data.gender == 'woman');
      allow update: if isSignedIn()
                    && resource.data.hostId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                    && request.resource.data.status in ['approved', 'denied'];
      allow delete: if false;
    }

    // Matches: readable by the two parties; created by the host (in the
    // approve transaction); immutable in v1.
    match /matches/{matchId} {
      // Split get/list: a `get` can freely dereference `resource.data` (a
      // single, already-fetched doc), but a `list` query must be provable
      // from the QUERY's own constraints alone — only the `participants`
      // `array-contains` branch is (the documented `array-contains` ->
      // `in` pattern); the `hostId`/`guestId` OR-branches aren't, so a
      // combined `read` denies every `list` (see the Chats tab's
      // `arrayContains('participants', uid)` query, which needs `list`).
      allow get: if isSignedIn()
                 && (resource.data.hostId == request.auth.uid
                     || resource.data.guestId == request.auth.uid
                     || (resource.data.participants is list
                         && request.auth.uid in resource.data.participants));
      allow list: if isSignedIn()
                  && request.auth.uid in resource.data.participants;
      // Create only via the real approve transaction (see
      // `matchApprovalValid`): doc id and `mealId`/`id` fields are the meal id,
      // no self-match, `participants` is exactly `[host, guest]`, no block
      // between them, and the same transaction sets the pending request to
      // `approved` and the open meal to `matched` with this guest.
      allow create: if isSignedIn()
                    && request.resource.data.hostId == request.auth.uid
                    && request.resource.data.mealId == matchId
                    && request.resource.data.id == matchId
                    && request.resource.data.guestId != request.auth.uid
                    && request.resource.data.participants
                         == [request.resource.data.hostId, request.resource.data.guestId]
                    && noBlockBetween(request.resource.data.hostId, request.resource.data.guestId)
                    && matchApprovalValid(matchId, request.resource.data.guestId, request.auth.uid);
      allow update, delete: if false;

      match /messages/{messageId} {
        allow read: if matchParticipant(matchId);
        allow create: if isSignedIn()
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 2000
                      && matchMessageCreateOk(matchId, request.auth.uid);
        allow update, delete: if false;
      }

      match /reads/{uid} {
        allow read: if matchParticipant(matchId);
        allow write: if matchParticipant(matchId) && uid == request.auth.uid;
      }
    }

    // User blocks: one user blocks another to prevent meal interactions
    match /blocks/{blockId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.pair;
      // Doc id pinned to `{callerUid}_{blockedUid}` (the id the app writes) so
      // a caller can't create blocks between strangers' id space.
      allow create: if isSignedIn()
                    && blockId == request.auth.uid + '_' + request.resource.data.blockedUid
                    && request.resource.data.blockerUid == request.auth.uid
                    && request.resource.data.blockerUid != request.resource.data.blockedUid
                    && request.resource.data.pair == [request.resource.data.blockerUid, request.resource.data.blockedUid];
      allow delete: if isSignedIn() && resource.data.blockerUid == request.auth.uid;
      allow update: if false;
    }

    match /reports/{reportId} {
      allow create: if isSignedIn()
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.targetType in ['user', 'meal', 'message'];
      allow read, update, delete: if false;
    }

    match /ratings/{ratingId} {
      // Same get/list split as `matches` (and the same shape as `requests`'
      // c133e20 fix): a `get` on a doc id ending in the caller's own uid
      // resolves "not yet rated" (not-exists, no error) instead of hanging
      // a listener on PERMISSION_DENIED — narrowed to the caller's own id
      // suffix so it isn't an existence oracle for anyone else's rating.
      // `list` can't dereference an as-yet-unfetched `resource.data`, so it
      // stays pinned to `raterUid` (provable only once the caller's own
      // `where('raterUid', ...)`-shaped query is used).
      allow get: if isSignedIn()
                 && ((resource == null && ratingId.matches('.*_' + request.auth.uid))
                     || (resource != null && resource.data.raterUid == request.auth.uid));
      allow list: if isSignedIn()
                  && resource.data.raterUid == request.auth.uid;
      // Doc id pinned to `{matchId}_{callerUid}` (the id the app writes): one
      // rating per rater per match, and no squatting another rater's id.
      allow create: if isSignedIn()
                    && ratingId == request.resource.data.matchId + '_' + request.auth.uid
                    && request.resource.data.raterUid == request.auth.uid
                    && request.resource.data.raterUid != request.resource.data.targetUid
                    && request.resource.data.stars is int
                    && request.resource.data.stars >= 1
                    && request.resource.data.stars <= 5
                    && request.resource.data.showedUp is bool
                    && (!('comment' in request.resource.data)
                        || request.resource.data.comment == null
                        || (request.resource.data.comment is string
                            && request.resource.data.comment.size() <= 200))
                    && ratingParticipantsValid(request.resource.data.matchId,
                                               request.resource.data.raterUid,
                                               request.resource.data.targetUid);
      allow update, delete: if false;
    }

    // Public reference data (handles, usernames, etc.) — adapt per project
    // Example:
    // match /handles/{handle} {
    //   allow read: if isSignedIn();
    //   allow create: if isSignedIn()
    //                 && request.resource.data.uid == request.auth.uid;
    //   allow delete: if isSignedIn()
    //                 && resource.data.uid == request.auth.uid;
    // }

    // Default deny — anything not explicitly matched is rejected.
  }
}
